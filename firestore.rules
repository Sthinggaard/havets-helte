rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A leader/admin is anyone signed in with a havetshelte.dk email address.
    // Mirrors the client-side rule in apps/www useAdminAuth.isAdminEmail.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^[^@]+@havetshelte[.]dk$');
    }

    // Events: anyone reads, leaders write
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Image library: leaders manage image assets for forms and event pages
    match /imageLibrary/{id} {
      allow read, write: if isAdmin();
    }

    // Image library categories: leaders manage categories
    match /imageLibraryCategories/{id} {
      allow read, write: if isAdmin();
    }

    // Signups: public names visible (forældre kan se hvem der er tilmeldt)
    // Oprettelse går via trusted backend path, ikke direkte fra browser
    match /signups/{id} {
      allow read: if true;
      allow create: if false;
      // Ledere kan toggle paid-status og rykke venteliste til/fra
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'waitlist']);
      allow delete: if isAdmin();
    }

    // SignupContacts: kun ledere læser (GDPR)
    // Oprettelse går via trusted backend path, ikke direkte fra browser
    match /signupContacts/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Members: kun ledere (attendance-feature)
    match /members/{id} {
      allow read, write: if isAdmin();
    }

    // Group teams: hold pr. gren/dag til medlemsopsætning
    match /groupTeams/{id} {
      allow read, write: if isAdmin();
    }

    // Group branches: aldersgrupper og branch metadata
    match /groupBranches/{id} {
      allow read, write: if isAdmin();
    }

    // Meetings: kun ledere
    match /meetings/{id} {
      allow read, write: if isAdmin();
    }

    // Attendance: kun ledere (ankomstregistrering)
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

  }
}
