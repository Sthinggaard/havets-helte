rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A leader/admin is anyone signed in with a havetshelte.dk email address.
    // Mirrors the client-side rule in apps/www useAdminAuth.isAdminEmail.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^[^@]+@havetshelte[.]dk$');
    }

    // Events: anyone reads, leaders write
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Image library: leaders manage image assets for forms and event pages
    match /imageLibrary/{id} {
      allow read, write: if isAdmin();
    }

    // Image library categories: leaders manage categories
    match /imageLibraryCategories/{id} {
      allow read, write: if isAdmin();
    }

    // Signups: public names visible (forældre kan se hvem der er tilmeldt).
    // Anyone can create a signup (no login required) — the write is validated
    // shape-only here; capacity/waitlist decisions happen client-side.
    match /signups/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['eventId', 'slotId', 'name', 'adult', 'groupSize', 'waitlist', 'created'])
        && request.resource.data.keys().hasAll(['eventId', 'slotId', 'name', 'adult', 'groupSize', 'created'])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() > 0
        && request.resource.data.slotId is string && request.resource.data.slotId.size() > 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.adult is bool
        && request.resource.data.groupSize is int && request.resource.data.groupSize >= 1 && request.resource.data.groupSize <= 20
        && (!('waitlist' in request.resource.data) || request.resource.data.waitlist is bool)
        && request.resource.data.created == request.time;
      // Ledere kan toggle paid-status og rykke venteliste til/fra
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'waitlist']);
      allow delete: if isAdmin();
    }

    // SignupContacts: kun ledere læser (GDPR). Anyone can create alongside a
    // signup (no login required); shape-only validation, never readable back.
    match /signupContacts/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['eventId', 'eventTitle', 'name', 'email', 'cancelToken', 'created'])
        && request.resource.data.keys().hasAll(['eventId', 'name', 'email', 'cancelToken', 'created'])
        && request.resource.data.eventId is string && request.resource.data.eventId.size() > 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.cancelToken is string
        && request.resource.data.created == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Members: kun ledere (attendance-feature)
    match /members/{id} {
      allow read, write: if isAdmin();
    }

    // Group teams: hold pr. gren/dag til medlemsopsætning
    match /groupTeams/{id} {
      allow read, write: if isAdmin();
    }

    // Group branches: aldersgrupper og branch metadata
    match /groupBranches/{id} {
      allow read, write: if isAdmin();
    }

    // Meetings: kun ledere
    match /meetings/{id} {
      allow read, write: if isAdmin();
    }

    // Attendance: kun ledere (ankomstregistrering)
    match /attendance/{id} {
      allow read, write: if isAdmin();
    }

  }
}
