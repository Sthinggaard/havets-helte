rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Events: anyone reads, authenticated leaders write
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Image library: authenticated leaders manage image assets for forms and event pages
    match /imageLibrary/{id} {
      allow read, write: if request.auth != null;
    }

    // Image library categories: authenticated leaders manage categories
    match /imageLibraryCategories/{id} {
      allow read, write: if request.auth != null;
    }

    // Signups: public names visible (forældre kan se hvem der er tilmeldt)
    // Oprettelse går via trusted backend path, ikke direkte fra browser
    match /signups/{id} {
      allow read: if true;
      allow create: if false;
      // Ledere kan toggle paid-status og rykke venteliste til/fra
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'waitlist']);
      allow delete: if request.auth != null;
    }

    // SignupContacts: kun autentificerede ledere læser (GDPR)
    // Oprettelse går via trusted backend path, ikke direkte fra browser
    match /signupContacts/{id} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Members: kun ledere (attendance-feature)
    match /members/{id} {
      allow read, write: if request.auth != null;
    }

    // Group teams: hold pr. gren/dag til medlemsopsætning
    match /groupTeams/{id} {
      allow read, write: if request.auth != null;
    }

    // Group branches: aldersgrupper og branch metadata
    match /groupBranches/{id} {
      allow read, write: if request.auth != null;
    }

    // Meetings: kun ledere
    match /meetings/{id} {
      allow read, write: if request.auth != null;
    }

    // Attendance: kun ledere (ankomstregistrering)
    match /attendance/{id} {
      allow read, write: if request.auth != null;
    }

  }
}
