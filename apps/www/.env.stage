# Staging environment (Firebase project: havets-helte-stage).
# Loaded by `vite build --mode stage` (npm run build:stage).
# TODO: replace the placeholders below with the staging project's web config
# from Firebase Console -> Project settings -> Your apps -> SDK setup.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_API_KEY=REPLACE_WITH_STAGE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=havets-helte-stage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=havets-helte-stage
VITE_FIREBASE_STORAGE_BUCKET=havets-helte-stage.firebasestorage.app
