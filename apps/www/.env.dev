# Dev environment (Firebase project: havets-helte-dev).
# Loaded by `vite build --mode dev` (npm run build:dev).
# This is the deployed cloud "dev" project, NOT local emulators — a bare
# `npm run dev` still uses Vite's default `development` mode + local .env.
# TODO: replace the placeholders below with the dev project's web config
# from Firebase Console -> Project settings -> Your apps -> SDK setup.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_API_KEY=REPLACE_WITH_DEV_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=havets-helte-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=havets-helte-dev
VITE_FIREBASE_STORAGE_BUCKET=havets-helte-dev.firebasestorage.app
