{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "apps/www/dist",
    "predeploy": [
      "node scripts/build-firebase-hosting.cjs"
    ],
    "rewrites": [
      {
        "source": "/share",
        "run": {
          "serviceId": "shareevent",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "auth": { "port": 9097 },
    "firestore": { "port": 8081 },
    "functions": { "port": 5004 },
    "hosting": { "port": 5003 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4001 }
  }
}
